pipeline {
    agent any

    triggers {
        pollSCM('H/2 * * * *')
    }

    environment {
        STAGING_NS = "kijani-staging"
        PROD_NS    = "default"
    }

    stages {
        stage('Initialize & Validate') {
            steps {
                echo 'Checking local system tooling presence...'
                sh 'terraform -version && ansible --version && kubectl version --client'
            }
        }

        stage('Infrastructure Provision') {
            steps {
                echo 'Provisioning isolated environments via Terraform...'
                dir('terraform') {
                    sh 'terraform init'
                    sh 'terraform import kubernetes_namespace.staging kijani-staging || true'
                    sh 'terraform apply -auto-approve'
                }
            }
        }

        stage('Deploy to Staging Namespace') {
            steps {
                echo 'Deploying application to staging using Ansible...'
                dir('ansible') {
                    sh "ansible-playbook site.yml -e 'k8s_namespace=${STAGING_NS} k8s_config_dir=staging'"
                }
            }
        }

        stage('Automated Smoke Testing') {
            steps {
                echo "Executing automated HTTP smoke test against ${STAGING_NS}..."
                sh """
                   kubectl rollout status deployment/kk-payments -n ${STAGING_NS} --timeout=60s
                   POD_NAME=\$(kubectl get pods -n ${STAGING_NS} -l app=kk-payments -o jsonpath='{.items[0].metadata.name}')
                   kubectl exec -n ${STAGING_NS} \$POD_NAME -- python3 -c "import urllib.request; assert urllib.request.urlopen('http://localhost:8080/healthz').status == 200"
                   echo "Staging HTTP /healthz smoke test PASSED."
                """
            }
        }

        stage('Production Promotion Gate') {
            steps {
                script {
                    def userInput = input(
                        id: 'ProceedToProd',
                        message: 'Promote KijaniKiosk Deployment to Production Cluster Bounds?',
                        parameters: [
                            string(defaultValue: 'Staging HTTP smoke tests verified', description: 'Provide the engineering change justification:', name: 'APPROVE_REASON')
                        ]
                    )
                    if (!userInput?.trim()) {
                        error("Approval reason cannot be empty.")
                    }
                    echo "PROMOTION AUTHORIZATION REASON LOGGED: ${userInput}"
                }
            }
        }

        stage('Deploy to Production') {
            steps {
                echo 'Deploying code updates to production namespaces...'
                dir('ansible') {
                    sh "ansible-playbook site.yml -e 'k8s_namespace=${PROD_NS} k8s_config_dir=production'"
                }
            }
        }
    }
}
